{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "outDir": "dist-site",
    "baseUrl": ".",
    "paths": {
      "@site/*": ["site/src/*"]
    }
  },
  "include": ["site/src/**/*", "site/src/**/*.vue"]
}
